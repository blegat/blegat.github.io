\RequirePackage{amsthm}
\theoremstyle{definition}
\newtheorem{myprop}{Proposition}[section]
\newcommand{\propref}[1]{Proposition~\ref{prop:#1}}
\newtheorem{mytheo}{Theorem}[section]
\newcommand{\theoref}[1]{Theorem~\ref{theo:#1}}
\newtheorem{mylem}{Lemma}[section]
\newcommand{\lemref}[1]{Lemma~\ref{lem:#1}}
\newtheorem{myconj}{Conjecture}[section]
\newcommand{\conjref}[1]{Conjecture~\ref{conj:#1}}
\newtheorem{myprob}{Problem}[section]
\newtheorem{mycons}{Constraint}[section]
\newtheorem{mycoro}{Corollary}[section]
\newcommand{\cororef}[1]{Corollary~\ref{coro:#1}}
\newtheorem{mydef}{Definition}[section]
\newcommand{\defref}[1]{Definition~\ref{def:#1}}
\newtheorem{myexem}{Example}[section]
\newcommand{\exemref}[1]{Example~\ref{exem:#1}}
\newtheorem{myrem}{Remark}[section]
\newcommand{\remref}[1]{Remark~\ref{rem:#1}}
\newtheorem{myprog}{Program}[section]
\newcommand{\progref}[1]{Program~\ref{prog:#1}}
\newtheorem{myassu}{Assumption}[section]
\newtheorem{myopen}{Open Question}[section]
