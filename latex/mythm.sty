\RequirePackage{amsthm}
\theoremstyle{definition}
\newtheorem{myprop}{Proposition}
\newcommand{\propref}[1]{Proposition~\ref{prop:#1}}
\newtheorem{mytheo}{Theorem}
\newcommand{\theoref}[1]{Theorem~\ref{theo:#1}}
\newtheorem{mylem}{Lemma}
\newcommand{\lemref}[1]{Lemma~\ref{lem:#1}}
\newtheorem{myconj}{Conjecture}
\newcommand{\conjref}[1]{Conjecture~\ref{conj:#1}}
\newtheorem{myprob}{Problem}
\newtheorem{mycons}{Constraint}
\newtheorem{mycoro}{Corollary}
\newcommand{\cororef}[1]{Corollary~\ref{coro:#1}}
\newtheorem{mydef}{Definition}
\newcommand{\defref}[1]{Definition~\ref{def:#1}}
\newtheorem{myexem}{Example}
\newcommand{\exemref}[1]{Example~\ref{exem:#1}}
\newtheorem{myrem}{Remark}
\newcommand{\remref}[1]{Remark~\ref{rem:#1}}
\newtheorem{myprog}{Program}
\newcommand{\progref}[1]{Program~\ref{prog:#1}}
\newtheorem{myassu}{Assumption}
\newtheorem{myopen}{Open Question}
